{
  "name": "stride-engine",
  "version": "0.1.0",
  "description": "Rule-based STRIDE threat detection with DREAD risk scoring for DevSecOps pipelines",
  "main": "src/engine/index.js",
  "bin": {
    "stride-engine": "src/cli.js"
  },
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.mjs",
    "build:schema": "node scripts/build-schema.js",
    "dev:ui": "vite --config ui/vite.config.mjs",
    "pretest": "npm run build:ui",
    "test": "node --test \"test/**/*.test.js\"",
    "analyze:example": "node src/cli.js analyze examples/ecommerce.json --format text",
    "prestart": "npm run build:ui",
    "start": "node src/api/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "threat-modelling",
    "stride",
    "dread",
    "devsecops",
    "security"
  ],
  "author": "Kelvin Osei Boateng",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "d3": "^7.9.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^6.4.5"
  }
}
